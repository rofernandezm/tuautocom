# TuAutoCom - Configuración de Desarrollo
# Copia este archivo a .env.dev y completa con tus valores locales

# Servidor
PORT=8000

# Base de Datos MongoDB
# Formato: mongodb://[usuario:contraseña@]host[:puerto]/base_datos
# Local: mongodb://localhost:27017/tuautocom_dev
DATABASE_URL=mongodb://localhost:27017/tuautocom_dev

# Entorno
NODE_ENV=development

# URLs API
API_BASE_URL=http://localhost:8000
API_TIMEOUT=5000

# Logging
LOG_LEVEL=debug

# CORS (desarrollo)
CORS_ORIGIN=http://localhost:8000,http://localhost:3000,http://localhost:5173

# Uploads (rutas de archivos)
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=5242880

# Secretos (reemplazar con valores reales)
# JWT_SECRET=tu_secreto_super_seguro_aqui
# API_KEY=tu_api_key_aqui
